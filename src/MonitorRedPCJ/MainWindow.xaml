<Window x:Class="MonitorRedPCJ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor de Red PCJ" Height="800" Width="1120" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource B.Bg}"
        FontFamily="{DynamicResource F.Main}"
        Style="{x:Null}">
    <DockPanel>
        <!-- Barra superior oscura -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource B.Header}" Height="64">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,26,0">
                    <!-- El sello: degradado de acento del tema, en diagonal. -->
                    <Ellipse Width="26" Height="26" Fill="{DynamicResource B.AuroraFill}"/>
                    <TextBlock Text="Monitor de Red PCJ" Foreground="{DynamicResource B.OnHeader}" FontSize="15"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            x:Name="NavPanel">
                    <RadioButton x:Name="TabTraffic" Style="{StaticResource TabButton}" Tag="&#xE9D9;"
                                 Content="Monitor de tráfico" IsChecked="True" Checked="OnTab"/>
                    <RadioButton x:Name="TabProtect" Style="{StaticResource TabButton}" Tag="&#xE72E;"
                                 Content="Protección" Checked="OnTab"/>
                    <RadioButton x:Name="TabHardware" Style="{StaticResource TabButton}" Tag="&#xE7F4;"
                                 Content="Recursos" Checked="OnTab"/>
                    <!-- La herramienta que el usuario elija en Configuración ocupa aquí el
                         hueco que dejaron escáner y registros. Oculta si no eligió ninguna. -->
                    <RadioButton x:Name="TabExtra" Style="{StaticResource TabButton}" Tag="&#xE774;"
                                 Content="Herramienta" Visibility="Collapsed" Checked="OnTab"/>
                    <Button x:Name="BtnTools" Style="{StaticResource TabLikeButton}" Tag="&#xE71D;"
                            Content="Más herramientas" Click="OnTools"
                            ToolTip="Las diez utilidades de seguridad de red"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button x:Name="BtnSettings" Style="{StaticResource GhostButton}" Content="&#xE713;"
                            FontFamily="{DynamicResource F.Icon}" FontSize="16"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource B.HeaderText}"
                            Click="OnSettings" ToolTip="Configuración"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Barra de estado inferior -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Line}"
                BorderThickness="0,1,0,0" Height="40">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNetName" Text="Red" Foreground="{DynamicResource B.TextDim}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  •  " Foreground="{DynamicResource B.Line}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSession" Text="Sesión: 0 B" Foreground="{DynamicResource B.TextDim}" FontSize="12"
                               VerticalAlignment="Center"/>
                    <!-- Pasilla del modo incógnito: solo se ve cuando no está guardando histórico.
                         Es clicable, así que se puede quitar sin buscar el menú de la bandeja. -->
                    <Button x:Name="IncognitoChip" Style="{StaticResource OnDarkButton}" Visibility="Collapsed"
                            Margin="14,0,0,0" Padding="10,4" FontSize="11.5"
                            Background="{DynamicResource B.IncogBg}" BorderBrush="{DynamicResource B.IncogEdge}" Foreground="{DynamicResource B.IncogFg}"
                            Click="OnToggleIncognito"
                            AutomationProperties.Name="Modo incógnito"
                            ToolTip="Modo incógnito activado: PCJ sigue monitorizando en vivo, pero no guarda
histórico en disco (ni tráfico por programa, ni registro, ni dispositivos). Al pinchar aquí
vuelve a grabar y recupera el histórico que había antes de activarlo.">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource B.IncogFg}" StrokeThickness="1.2"/>
                                <Line X1="2.6" Y1="9.4" X2="9.4" Y2="2.6" Stroke="{DynamicResource B.IncogFg}" StrokeThickness="1.5"/>
                            </Grid>
                            <TextBlock Text="Incógnito" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Path Data="M 0,6 L 6,0 L 6,4 L 12,4 L 12,-2 L 0,-2 Z" Fill="{DynamicResource B.Green}"
                          RenderTransform="{x:Null}" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Path.LayoutTransform>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                        </Path.LayoutTransform>
                    </Path>
                    <TextBlock x:Name="TxtRx" Text="0 B/s" Foreground="{DynamicResource B.Green}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Path Data="M 0,0 L 12,0 L 12,-4 L 6,-4 L 6,2 L 0,2 Z" Fill="{DynamicResource B.Amber}"
                          Margin="0,0,4,0" VerticalAlignment="Center">
                        <Path.LayoutTransform>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                        </Path.LayoutTransform>
                    </Path>
                    <TextBlock x:Name="TxtTx" Text="0 B/s" Foreground="{DynamicResource B.Amber}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid x:Name="ContentHost" Margin="18,14"/>
    </DockPanel>
</Window>
