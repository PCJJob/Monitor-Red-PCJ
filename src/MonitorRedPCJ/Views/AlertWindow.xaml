<Window x:Class="MonitorRedPCJ.Views.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva actividad de red" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Cursor="SizeAll"
        WindowStartupLocation="Manual">
    <Border Background="{DynamicResource B.Panel}" CornerRadius="14" BorderBrush="{DynamicResource B.Line}"
            BorderThickness="1" Padding="20" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource B.AuroraFill}">
                    <TextBlock Text="&#xE968;" FontFamily="{DynamicResource F.Icon}" FontSize="20"
                               Foreground="{DynamicResource B.OnHeader}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Nueva actividad de red" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.Text}"/>
                    <TextBlock x:Name="TxtSub" FontSize="12" Foreground="{DynamicResource B.TextDim}"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource B.Bg}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="TxtApp" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                    <TextBlock x:Name="TxtHost" FontSize="12" Foreground="{DynamicResource B.TextDim}" Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Nombre y ruta completos de la aplicación -->
            <Button x:Name="BtnDetails" Content="Ver nombre y ruta completos" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,4" FontSize="11" Click="OnDetails"/>

            <Border x:Name="PanelDetails" Visibility="Collapsed" Background="{DynamicResource B.Bg}"
                    CornerRadius="8" Padding="12" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="NOMBRE" Style="{StaticResource StatLabel}" FontSize="10"/>
                    <TextBlock x:Name="TxtDetailName" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource B.Text}" Margin="0,2,0,0"/>

                    <TextBlock Text="ARCHIVO EJECUTABLE" Style="{StaticResource StatLabel}" FontSize="10" Margin="0,10,0,0"/>
                    <!-- Caja de solo lectura: la ruta se puede seleccionar y copiar -->
                    <TextBox x:Name="TxtDetailPath" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                             Background="Transparent" FontFamily="Consolas, Segoe UI" FontSize="11" Padding="0"
                             Foreground="{DynamicResource B.TextDim}" Margin="0,2,0,0"/>

                    <TextBlock x:Name="TxtDetailMeta" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{DynamicResource B.TextDim}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Copiar ruta" Style="{StaticResource GhostButton}" Padding="10,4"
                                FontSize="11" Click="OnCopyPath"/>
                        <Button x:Name="BtnOpenFolder" Content="Abrir carpeta" Style="{StaticResource GhostButton}"
                                Padding="10,4" FontSize="11" Margin="8,0,0,0" Click="OnOpenFolder"/>
                    </StackPanel>

                    <!-- Análisis: ¿qué pasa si le quito la salida a esta app? -->
                    <Border x:Name="RiskCard" CornerRadius="8" Padding="11,9" Margin="0,12,0,0"
                            Background="{DynamicResource B.ChipWarnBg}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="TxtRiskLabel" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Text}"/>
                            <TextBlock x:Name="TxtRiskWhat" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Foreground="{DynamicResource B.Text}"/>
                            <TextBlock x:Name="TxtRiskEffect" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource B.Text}"/>
                            <TextBlock x:Name="TxtRiskAdvice" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       FontStyle="Italic" Foreground="{DynamicResource B.TextDim}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Salida y entrada: la duda típica es por qué una puede estar abierta y otra cerrada -->
            <Button x:Name="BtnWhy" Content="¿Diferencia entre bloquear la salida y la entrada?"
                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Padding="10,4" FontSize="11" Click="OnWhy"/>

            <Border x:Name="PanelWhy" Visibility="Collapsed" CornerRadius="8" Margin="0,8,0,0"
                    Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BLOQUEAR LA SALIDA" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource B.TextDim}"/>
                        <TextBlock Text="Es lo que el programa manda hacia internet. Si se corta, el programa no puede conectar: no carga páginas, no se actualiza, no avisa de nada."
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0"
                                   Foreground="{DynamicResource B.Text}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BLOQUEAR LA ENTRADA" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource B.TextDim}"/>
                        <TextBlock Text="Es lo que otros equipos de la red le piden a tu PC. Si se corta, nadie puede conectarse a ese programa (ni carpetas, ni impresora, ni servidores). Navegar no se ve afectado."
                                   FontSize="11.5" TextWrapping="Wrap" LineHeight="17" Margin="0,4,0,0"
                                   Foreground="{DynamicResource B.Text}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" FontSize="11"
                               TextWrapping="Wrap" Foreground="{DynamicResource B.TextDim}"
                               Text="Son dos permisos independientes: por eso una aplicación puede estar en verde en SALIDA y en gris en ENTRADA. Windows ya corta la entrada por defecto, así que casi nunca hace falta cambiarla. Los botones de esta ventana deciden solo la SALIDA."/>
                </Grid>
            </Border>

            <TextBlock Text="¿Quieres permitirle acceso a internet?" FontSize="12"
                       Foreground="{DynamicResource B.Text}" Margin="0,14,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnBlock" Content="Bloquear" Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Stretch" Click="OnBlock"/>
                <Button Grid.Column="2" x:Name="BtnAllow" Content="Permitir" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Click="OnAllow"/>
            </Grid>
            <Button Content="Solo esta vez" Style="{StaticResource GhostButton}" HorizontalAlignment="Center"
                    Margin="0,8,0,0" Padding="12,4" FontSize="11" Click="OnOnce"/>
        </StackPanel>
    </Border>
</Window>
