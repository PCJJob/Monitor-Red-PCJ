<Window x:Class="MonitorRedPCJ.Views.AccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quién puede salir a internet" Width="760" Height="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource B.Bg}"
        FontFamily="{DynamicResource F.Main}" ShowInTaskbar="True">
    <Window.Resources>
        <DataTemplate x:Key="RowTemplate">
            <Border x:Name="row" CornerRadius="8" Padding="8,7" Margin="0,0,0,2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource B.HoverRow}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding Allowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center" ToolTip="Tiene salida a internet"
                              Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B.Text}"/>
                        <TextBlock Text="{Binding Folder}" FontSize="11" MaxWidth="330" HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.TextDim}"/>
                    </StackPanel>

                    <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="6"
                            Padding="9,3" Background="{Binding RiskBg}" ToolTip="{Binding RiskTip}">
                        <TextBlock Text="{Binding RiskLabel}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{Binding RiskColor}"/>
                    </Border>

                    <TextBlock Grid.Column="3" Text="{Binding Traffic}" FontSize="11" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Foreground="{DynamicResource B.TextDim}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="18">
        <!-- Explicación -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Bloqueo total: decides tú app por app" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.Text}"/>
                    <TextBlock x:Name="TxtIntro" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="560"
                               HorizontalAlignment="Left" Foreground="{DynamicResource B.TextDim}">
                        Al activarlo, Windows cortará TODA la salida a internet y solo tendrán conexión
                        las aplicaciones que marques aquí. Es el modo estricto: lo que no marques se queda sin red.
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource B.ChipWarnBg}" CornerRadius="8" Padding="12,9" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource B.Line}" BorderThickness="1" MaxWidth="220">
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource B.Text}">
                        Mantén marcadas las que necesites ahora (navegador y los componentes de Windows
                        que dicen «esencial»). Si te equivocas, se deshace con un clic.
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- Botones -->
        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="TxtCount" FontSize="12" Margin="2,0,0,9"
                           Foreground="{DynamicResource B.TextDim}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnEssential" Content="Marcar solo lo esencial" Style="{StaticResource GhostButton}"
                            Click="OnEssential" Margin="0,0,8,0"/>
                    <Button x:Name="BtnAll" Content="Marcar todas" Style="{StaticResource GhostButton}"
                            Click="OnAll" Margin="0,0,8,0"/>
                    <Button x:Name="BtnNone" Content="Quitar todas" Style="{StaticResource GhostButton}"
                            Click="OnNone" Margin="0,0,10,0"/>
                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Click="OnCancel" Margin="0,0,10,0"/>
                    <Button x:Name="BtnApply" Content="Activar bloqueo total" Style="{StaticResource DangerButton}"
                            Click="OnApply"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Lista -->
        <Border Style="{StaticResource Card}" Padding="10,12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="✓" FontSize="11" Foreground="{DynamicResource B.TextDim}"/>
                    <TextBlock Grid.Column="1" Text="APLICACIÓN" Style="{StaticResource StatLabel}" FontSize="10"/>
                    <TextBlock Grid.Column="2" Text="ANÁLISIS DE SEGURIDAD" Style="{StaticResource StatLabel}" FontSize="10"/>
                    <TextBlock Grid.Column="3" Text="TRÁFICO" Style="{StaticResource StatLabel}" FontSize="10"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Grid DockPanel.Dock="Top" Margin="4,0,4,10" HorizontalAlignment="Right" Width="240">
                    <TextBox x:Name="Search" TextChanged="OnSearch"/>
                    <TextBlock x:Name="SearchHint" Text="Buscar aplicación…" FontSize="12" IsHitTestVisible="False"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource B.TextDim}"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="List" ItemTemplate="{StaticResource RowTemplate}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
