<UserControl x:Class="MonitorRedPCJ.Views.TrayMenuBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="330">
    <UserControl.Resources>
        <FontFamily x:Key="F.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Fila del menú: icono + texto + marca de activado. Es un ToggleButton para todas
             las filas: así el mismo diseño sirve para las acciones y para los dos interruptores
             (Siesta e Incógnito), y el estado se pinta con un solo juego de disparadores. -->
        <Style x:Key="Row" TargetType="ToggleButton">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                Padding="9,0,7,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ico" Grid.Column="0" Text="{TemplateBinding Tag}"
                                           FontFamily="{DynamicResource F.Icon}" FontSize="17"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" Opacity="0.74"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Margin="11,0,0,0"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock x:Name="chk" Grid.Column="2" Text="&#xE73E;"
                                           FontFamily="{DynamicResource F.Icon}" FontSize="13"
                                           Foreground="{DynamicResource B.Teal}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ico" Property="Opacity" Value="1"/>
                                <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource B.Teal}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource B.Teal}"/>
                                <Setter TargetName="ico" Property="Opacity" Value="1"/>
                            </Trigger>
                            <!-- Sin esto una fila desactivada seguiría con el negro de siempre:
                                 el texto lo dibujamos nosotros, no el sistema. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.Selected}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.HoverRow}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.Pressed}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- La salida en coral: se distingue del resto sin necesidad de bordes gruesos. -->
        <Style x:Key="RowDanger" TargetType="ToggleButton" BasedOn="{StaticResource Row}">
            <Setter Property="Foreground" Value="{DynamicResource B.ChipBadFg}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.ChipBadBg}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.ChipBadPress}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Hair" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource B.Divider}"/>
            <Setter Property="Margin" Value="18,5"/>
        </Style>
    </UserControl.Resources>

    <!-- Dieciocho px por cada lado: sitio para la sombra. Se prueban aquí dentro del popup
         de Windows, que mide lo que mide la tarjeta y recorta todo lo que se salga. -->
    <Border Margin="18" Background="Transparent">
        <Border Background="{DynamicResource B.Panel}" CornerRadius="14" BorderBrush="{DynamicResource B.Edge}"
                BorderThickness="1" Padding="7,8,7,8">
            <Border.Effect>
                <!-- El color de una sombra se declara a propósito y en claro: WPF no admite
                     DynamicResource dentro de un Freezable, así que no puede seguir al tema.
                     Se eligió un azul muy apagado y al 22 % de opacidad, que sobre fondo
                     claro hace de sombra y sobre Nocturna apenas se ve — ni en un caso ni en
                     el otro desentona. Es el único literal de color que queda en esta vista. -->
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.22" Color="#1B3A4C"/>
            </Border.Effect>
            <StackPanel>
                <!-- Cabecera: la misma pastilla degradada de la ventana de alerta -->
                <Grid Margin="4,2,4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource B.AuroraFill}">
                        <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource F.Icon}" FontSize="15"
                                   Foreground="{DynamicResource B.OnHeader}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Monitor de Red PCJ" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource B.Text}"/>
                        <TextBlock x:Name="TxtSub" FontSize="11" Margin="0,1,0,0"
                                   Foreground="{DynamicResource B.TextDim}"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Hair}"/>

                <ToggleButton x:Name="RowShow" Style="{StaticResource Row}" Tag="&#xE890;"
                              Content="Mostrar el monitor" Click="OnShow"/>
                <Border Style="{StaticResource Hair}"/>
                <ToggleButton x:Name="RowSiesta" Style="{StaticResource Row}" Tag="&#xE708;"
                              Content="Siesta (pausar alertas)" Click="OnSiesta"/>
                <ToggleButton x:Name="RowIncognito" Style="{StaticResource Row}" Tag="&#xE928;"
                              Content="Incógnito (no registrar)" Click="OnIncognito">
                    <ToggleButton.ToolTip>
                        <TextBlock MaxWidth="260" TextWrapping="Wrap" FontSize="12"
                                   Text="No guarda histórico en disco: ni el tráfico acumulado por programa, ni los registros, ni los dispositivos vistos. Sigue monitorizando en vivo y sigue cortando o dejando salir según las reglas del firewall."/>
                    </ToggleButton.ToolTip>
                </ToggleButton>
                <Border Style="{StaticResource Hair}"/>
                <ToggleButton x:Name="RowSettings" Style="{StaticResource Row}" Tag="&#xE713;"
                              Content="Configuración…" Click="OnSettings"/>
                <ToggleButton x:Name="RowAdmin" Style="{StaticResource Row}" Tag="&#xE8D7;"
                              Content="Reiniciar como administrador" Click="OnAdmin"/>
                <Border Style="{StaticResource Hair}"/>
                <ToggleButton x:Name="RowExit" Style="{StaticResource RowDanger}" Tag="&#xE7E8;"
                              Content="Salir" Click="OnExit"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
