<UserControl x:Class="MonitorRedPCJ.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MonitorRedPCJ.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Resumen rápido -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10">
            <UniformGrid Rows="1" Columns="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Coral}" VerticalAlignment="Center"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock x:Name="TileCpu" Text="0 %" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource B.Text}"/>
                        <TextBlock Text="Uso de CPU" Style="{StaticResource StatLabel}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Indigo}" VerticalAlignment="Center"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock x:Name="TileMem" Text="0 GB" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource B.Text}"/>
                        <TextBlock Text="Memoria usada" Style="{StaticResource StatLabel}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Teal}" VerticalAlignment="Center"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock x:Name="TileDisk" Text="0 B/s" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource B.Text}"/>
                        <TextBlock Text="Lectura de disco" Style="{StaticResource StatLabel}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Amber}" VerticalAlignment="Center"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock x:Name="TileNet" Text="0 B/s" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource B.Text}"/>
                        <TextBlock Text="Red (total)" Style="{StaticResource StatLabel}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Line}" VerticalAlignment="Center"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock x:Name="TileGpu" Text="N/D" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource B.Text}"/>
                        <TextBlock Text="GPU" Style="{StaticResource StatLabel}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Green}" VerticalAlignment="Center"/>
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock x:Name="TileTemp" Text="—" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource B.Text}"/>
                        <TextBlock Text="Temp. disco" Style="{StaticResource StatLabel}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Cuatro series con la misma calidad que el monitor de tráfico -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="170"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*" MinHeight="170"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,10,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Coral}" VerticalAlignment="Center"/>
                            <TextBlock Text="Uso de CPU" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                       Foreground="{DynamicResource B.Text}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="PeakCpu" Text="máx 0 %" FontSize="11" Margin="0,0,10,0"
                                       Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValCpu" Text="0 %" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Coral}"/>
                        </StackPanel>
                    </Grid>
                    <c:ResourceGraph x:Name="ChartCpu" Unit="Percent" Stroke="{DynamicResource B.Coral}"
                                     EmptyText="Midiendo el procesador…" Margin="4,2,4,6"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,10,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Indigo}" VerticalAlignment="Center"/>
                            <TextBlock Text="Memoria" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                       Foreground="{DynamicResource B.Text}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="PeakMem" Text="máx 0 GB" FontSize="11" Margin="0,0,10,0"
                                       Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValMem" Text="0 GB" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Indigo}"/>
                        </StackPanel>
                    </Grid>
                    <c:ResourceGraph x:Name="ChartMem" Unit="Memory" Stroke="{DynamicResource B.Indigo}"
                                     EmptyText="Midiendo la memoria…" Margin="4,2,4,6"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,10,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Teal}" VerticalAlignment="Center"/>
                            <TextBlock Text="Transferencia de disco" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                       Foreground="{DynamicResource B.Text}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="PeakDisk" Text="máx 0 B/s" FontSize="11" Margin="0,0,10,0"
                                       Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValDisk" Text="0 B/s" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Teal}"/>
                        </StackPanel>
                    </Grid>
                    <c:ResourceGraph x:Name="ChartDisk" Unit="Data" Stroke="{DynamicResource B.Teal}"
                                     EmptyText="Midiendo el disco…" Margin="4,2,4,6"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,10,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Amber}" VerticalAlignment="Center"/>
                            <TextBlock Text="Red (total)" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                       Foreground="{DynamicResource B.Text}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="PeakNet" Text="máx 0 B/s" FontSize="11" Margin="0,0,10,0"
                                       Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ValNet" Text="0 B/s" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.Amber}"/>
                        </StackPanel>
                    </Grid>
                    <c:ResourceGraph x:Name="ChartNet" Unit="Data" Stroke="{DynamicResource B.Amber}"
                                     EmptyText="Esperando tráfico…" Margin="4,2,4,6"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
