<UserControl x:Class="MonitorRedPCJ.Views.TrafficView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MonitorRedPCJ.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Sin MinHeight, las listas (fila Auto) se comían la altura del gráfico -->
            <RowDefinition Height="5*" MinHeight="230"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="6*" MinHeight="150"/>
        </Grid.RowDefinitions>

        <!-- Gráfico principal -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <c:TrafficGraph x:Name="Graph" MinHeight="220"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0"
                        Background="{DynamicResource B.Raised}" CornerRadius="8" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Green}" VerticalAlignment="Center"/>
                        <TextBlock Text="Descarga" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource B.TextDim}"/>
                        <TextBlock x:Name="LegendRx" Text="0 B/s" FontSize="11" FontWeight="SemiBold"
                                   Margin="6,0,16,0" Foreground="{DynamicResource B.Text}"/>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource B.Amber}" VerticalAlignment="Center"/>
                        <TextBlock Text="Subida" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource B.TextDim}"/>
                        <TextBlock x:Name="LegendTx" Text="0 B/s" FontSize="11" FontWeight="SemiBold"
                                   Margin="6,0,0,0" Foreground="{DynamicResource B.Text}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Listas: apps y hosts -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Aplicaciones" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource B.Text}" Margin="0,0,0,8"/>
                    <ListView x:Name="AppsList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Aplicación" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                                                <Border Background="{DynamicResource B.ChipOkBg}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                        Visibility="{Binding NewTag}">
                                                    <TextBlock Text="NUEVA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource B.Green}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="↓" Width="86" DisplayMemberBinding="{Binding RxText}"/>
                                <GridViewColumn Header="↑" Width="86" DisplayMemberBinding="{Binding TxText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Hosts remotos" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource B.Text}" Margin="0,0,0,8"/>
                    <ListView x:Name="HostsList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Host" Width="230" DisplayMemberBinding="{Binding Host}"/>
                                <GridViewColumn Header="App" Width="120" DisplayMemberBinding="{Binding App}"/>
                                <GridViewColumn Header="Total de la app" Width="110" DisplayMemberBinding="{Binding Total}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
