<UserControl x:Class="MonitorRedPCJ.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="FilterCombo" Width="150" SelectionChanged="OnFilter">
                        <ComboBoxItem Content="Importantes" IsSelected="True"/>
                        <ComboBoxItem Content="Todos"/>
                    </ComboBox>
                    <ComboBox x:Name="TimeCombo" Width="130" Margin="10,0,0,0" SelectionChanged="OnFilter">
                        <ComboBoxItem Content="Todo el tiempo" IsSelected="True"/>
                        <ComboBoxItem Content="Hoy"/>
                        <ComboBoxItem Content="Últimos 7 días"/>
                    </ComboBox>
                </StackPanel>
                <Button Content="Marcar todo como leído" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" Click="OnMarkRead"/>
            </Grid>
            <ListBox x:Name="EventsList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    Background="{Binding Badge}" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{DynamicResource B.Text}"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource B.TextDim}"
                                           Visibility="{Binding DetailVis}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource B.TextDim}"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource B.Line}"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
