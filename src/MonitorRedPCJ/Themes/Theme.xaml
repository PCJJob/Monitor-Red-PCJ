<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         HOJAS DE ESTILO — el "cómo se coloca" de Monitor de Red PCJ
         ============================================================
         Desde la 1.5.0 este archivo ya NO lleva colores. Los colores viven en
         Themes/Temas/*.xaml (Aurora, Nocturna, Bruma) y aquí se citan con
         DynamicResource, que es lo que permite cambiar el aspecto entero de la
         aplicación sin cerrar ni reconstruir ninguna ventana: al cambiar la
         paleta, cada elemento vuelve a pedir su pincel y se repinta solo.

         Dos reglas para no romper eso:
           · Nada de escribir un #RRGGBB suelto en una plantilla. Si hace falta
             un color nuevo, se añade a las tres paletas y se le pone clave.
           · Nada de animar el Color de un pincel que venga de la paleta: esos
             pinceles son compartidos y la animación los cambiaría en toda la
             aplicación. Se anima opacidad, tamaño o posición.

         Las claves de siempre (Pill, Card, SegButton, Switch…) se conservan
         todas: las vistas que ya existían no hay que tocarlas. -->

    <!-- ============================================================
         TIPOGRAFÍA DE USO CORRIENTE
         ============================================================ -->

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Línea que acompaña a un título de sección: explica para qué sirve -->
    <Style x:Key="SectionLead" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="MaxWidth" Value="600"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="StatNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
    </Style>

    <!-- Rótulo de columna de la tabla -->
    <Style x:Key="ColHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="{DynamicResource Sz.Col}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================================================
         BOTONES DE LA BARRA SUPERIOR
         ============================================================ -->

    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource B.HeaderText}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- La pestaña activa se marca con una pastilla y con una raya de acento
                         debajo que crece desde el centro: es el detalle que hace que cambiar
                         de pestaña se vea en vez de simplemente ocurrir. -->
                    <Grid>
                        <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource R.Button}"
                                Padding="14,8" Margin="2,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="icon" Text="{TemplateBinding Tag}" FontFamily="{DynamicResource F.Icon}"
                                           FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="under" Height="2.5" CornerRadius="2" VerticalAlignment="Bottom"
                                Margin="16,0,16,0" HorizontalAlignment="Stretch"
                                Background="{DynamicResource B.AuroraLine}" Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="underScale" ScaleX="0.3" CenterX="0.5"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.BannerChip}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.BannerText}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="underScale"
                                                         Storyboard.TargetProperty="ScaleX" To="1"
                                                         Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="under"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="underScale"
                                                         Storyboard.TargetProperty="ScaleX" To="0.3"
                                                         Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="under"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="#10FFFFFF"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- «Más herramientas» va en la misma fila que las pestañas pero no es una pestaña:
         abre una ventana aparte. Por eso necesita su propio estilo de Button, calcado de
         TabButton para que la familia visual no se rompa. -->
    <Style x:Key="TabLikeButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.HeaderText}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource R.Button}"
                            Padding="14,8" Margin="2,0"
                            BorderBrush="{DynamicResource B.BannerChipEdge}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{DynamicResource F.Icon}"
                                       FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.BannerChip}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.BannerChipEdge}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.BannerText}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         BOTONES DE MANDO
         ============================================================ -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource B.TealFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.FieldEdge}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.OnAccent}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Doble trazo: borde exterior y relleno interior. Define el botón sin
                     recurrir a sombras, que son lentas al desplazar la lista. -->
                    <Border x:Name="outer" Background="{TemplateBinding BorderBrush}"
                            CornerRadius="{DynamicResource R.Button}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" Padding="0,0,0,1">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource R.Button}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            <Setter TargetName="outer" Property="Padding" Value="0,1,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource B.CoralFill}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Botón secundario: va sobre el fondo de la tarjeta y se define por su contorno -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource B.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Edge}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource R.Button}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón claro sobre la banda oscura del encabezado -->
    <Style x:Key="OnDarkButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource B.BannerChip}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.BannerChipEdge}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.BannerText}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource R.Button}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#8FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#4DFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón sin marco: sirve para una fila entera que se pulsa (encabezado plegable) -->
    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         PÍLDORAS DE PERMISO
         ============================================================ -->

    <Style x:Key="Pill" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource R.Pill}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PillAllow" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource B.GreenFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.ChipOkFg}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="PillBlock" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource B.SlateFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Slate}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <!-- Sin regla nuestra: Windows decide. Se muestra como contorno, no relleno. -->
    <Style x:Key="PillPending" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{DynamicResource B.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Edge}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
    </Style>

    <!-- ============================================================
         TARJETAS Y CHIPS
         ============================================================ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Panel}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- Tarjeta hundida: el hueco donde va la lista, para que las filas claras
         (u oscuras) se lean por encima del fondo de la tarjeta madre. -->
    <Style x:Key="CardSunken" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.BgDeep}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="ChipAllow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.ChipOkBg}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Chip}"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>
    <Style x:Key="ChipBlock" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.ChipBadBg}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Chip}"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>
    <Style x:Key="ChipPending" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.ChipNeutralBg}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Chip}"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Distintivo de una palabra dentro de la fila (sistema, análisis…) -->
    <Style x:Key="TagChip" TargetType="Border">
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Chip}"/>
        <Setter Property="Background" Value="{DynamicResource B.ChipNeutralBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Chip pequeño de estado dentro de la tarjeta de la herramienta. -->
    <Style x:Key="ToolChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Background" Value="{DynamicResource B.ChipNeutralBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ============================================================
         CONTADORES DE LA BANDA DE PROTECCIÓN
         ============================================================
         Un número grande y su etiqueta encima de un recuadrito. Lo que antes
         era una frase de texto corrido se lee de un vistazo, y el color de la
         cifra dice si ese número es bueno, malo o neutro. -->
    <Style x:Key="StatChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.BannerChip}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.BannerChipEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Panel}"/>
        <Setter Property="Padding" Value="12,7,12,7"/>
        <Setter Property="MinWidth" Value="86"/>
    </Style>

    <Style x:Key="StatBig" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.BannerText}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>

    <Style x:Key="StatSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.BannerTextFaint}"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <!-- ============================================================
         CONTROL SEGMENTADO (grupo de aplicaciones)
         ============================================================
         La pastilla de debajo es un solo elemento que se desliza de un tramo a
         otro; los botones van encima transparentes. Eso es lo que hace que
         cambiar de grupo se vea moverse en vez de parpadear. -->
    <Style x:Key="SegGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Field}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.FieldEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Field}"/>
        <Setter Property="Padding" Value="3"/>
    </Style>

    <Style x:Key="SegButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent"
                            CornerRadius="{DynamicResource R.Button}" Padding="11,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on">
                            <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         BUSCADOR
         ============================================================ -->
    <Style x:Key="SearchField" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Field}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.FieldEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource R.Field}"/>
    </Style>

    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource B.Accent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Botón de limpiar (la ✕ del buscador) -->
    <Style x:Key="ClearButton" TargetType="Button">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Icon}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                        <TextBlock Text="&#xE711;" FontSize="11" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Pressed}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         CABECERA DE COLUMNA QUE ORDENA
         ============================================================ -->
    <Style x:Key="SortHeader" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="{DynamicResource Sz.Col}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="#00FFFFFF" CornerRadius="{DynamicResource R.Chip}"
                            Padding="6,4" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Line}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tirador de columna: la línea fina que se puede arrastrar. Al pasar el
         ratón se ensancha y toma el color de acento. -->
    <Style x:Key="SplitLine" TargetType="Border">
        <Setter Property="Width" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource B.Line}"/>
    </Style>

    <!-- ============================================================
         LISTAS
         ============================================================ -->

    <Style TargetType="ListViewItem">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource R.Row}"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista con cabecera de columnas. Sin este estilo el ListView se queda con su
         fondo blanco de Windows y las columnas con su cabecera gris: en Nocturna salía
         un rectángulo clarísimo en mitad de la tarjeta y el nombre de las aplicaciones,
         escrito en claro sobre blanco, desaparecía. La lista se vuelve transparente
         para que mande la tarjeta de detrás, y el texto de las columnas que se llenan
         por DisplayMemberBinding hereda el Foreground de la fila. -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Cabecera de columna: una pastilla suave con el título atenuado, en vez del
         encabezado gris con sus líneas en relieve. El tirador de la derecha se
         conserva transparente para poder seguir ensanchando las columnas. -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="hd" CornerRadius="{DynamicResource R.Tile}"
                                Background="{DynamicResource B.BarTrack}" Padding="9,5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" Width="9" HorizontalAlignment="Right"
                               Cursor="SizeWE" Background="Transparent" BorderThickness="0">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hd" Property="Background" Value="{DynamicResource B.Edge}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <!-- El presentador de columnas añade una cabecera suelta para
                             rellenar lo que sobre a la derecha. No tiene columna ni título,
                             y pintarla dejaba una pastilla vacía al final de la fila: se
                             apaga aquí en vez de en cada lista. -->
                        <Trigger Property="Column" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- Lo mismo para una columna de verdad que no lleva título, como
                             la primera del escáner, que solo echa el punto de estado: sin
                             esto se ve una pastilla vacía abriendo la fila. -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- La fila de cabeceras en sí: quita el fondo y el reborde que el presentador
         de GridView trae puestos. -->
    <Style TargetType="GridViewHeaderRowPresenter">
        <Setter Property="Margin" Value="2,2,2,6"/>
    </Style>

    <!-- Contenedor neutro: sin selección ni realce propio, para que la fila mande -->
    <Style x:Key="AppRowContainer" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tarjeta de herramienta en la lista de la izquierda de «Más herramientas» -->
    <Style x:Key="ToolTile" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" CornerRadius="{DynamicResource R.Card}" BorderThickness="1.4"
                            Background="{DynamicResource B.Raised}" BorderBrush="{DynamicResource B.Line}"
                            Padding="10,9">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Panel}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Edge}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Panel}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.16"
                                                      Color="#101A22"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         MENÚ LATERAL DE CONFIGURACIÓN
         ============================================================
         Las entradas de Ajustes se ponen como las filas de Protección: una pastilla
         redondeada con su icono, y cuando está elegida se le marca el lado con la
         misma raya de acento en degradado que lleva el detalle de cada fila. Así la
         ventana de ajustes no parece de otra pieza, y el usuario reconoce el idioma
         visual en cuanto entra. -->
    <Style x:Key="NavTile" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="{DynamicResource R.Button}"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                Padding="11,9">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <!-- La raya de la izquierda: crece desde el centro al elegir la entrada,
                             que es lo que hace que el cambio de sección se vea y no solo ocurra.
                             Se anima su alto, no un transform: un transform declarado aquí dentro
                             no lo puede apuntar un Setter del disparador, y sin ese Setter la
                             entrada que ya viene elegida al abrir la ventana saldría sin marca. -->
                        <Border x:Name="rail" Width="3" Height="6" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource B.AuroraLine}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Selected}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.SelectedEdge}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="rail" Property="Opacity" Value="1"/>
                            <Setter TargetName="rail" Property="Height" Value="20"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="rail"
                                                         Storyboard.TargetProperty="Opacity" To="1"
                                                         Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="rail"
                                                         Storyboard.TargetProperty="Height" To="20"
                                                         Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="rail"
                                                         Storyboard.TargetProperty="Opacity" To="0"
                                                         Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="rail"
                                                         Storyboard.TargetProperty="Height" To="6"
                                                         Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         CONTROLES DE WINDOWS QUE QUEDAN FEOS SIN TOCAR
         ============================================================ -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="Background" Value="{DynamicResource B.Field}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource B.Accent}"/>
    </Style>

    <!-- Casilla de toda la vida redibujada: el cuadrito gris de Windows no pega
         con el resto, y en Ajustes hay muchas. -->
    <Style x:Key="CheckRow" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="20" Height="20" CornerRadius="6" VerticalAlignment="Center"
                                Background="{DynamicResource B.Field}" BorderBrush="{DynamicResource B.Edge}"
                                BorderThickness="1.4">
                            <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{DynamicResource F.Icon}"
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource B.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource B.TealFill}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                            <Setter TargetName="tick" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- La misma forma puesta por defecto. Antes el estilo suelto de CheckBox solo
         añadía tipografía, así que cualquier casilla escrita sin Style (la de
         «Auto-escaneo» del escáner, las de permiso de la ventana de acceso) salía
         con el cuadrito gris nativo encima de la tarjeta oscura. -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource CheckRow}"/>

    <!-- MENÚS FLOTANTES: el gris de Windows fuera
         Las pastillas de permiso y los botones de la bandeja abren menús
         ContextMenu. Sin este estilo saldrían con el cuadro clásico de 1998,
         que es justo lo que desentona del resto de la ventana. -->
    <Style x:Key="MenuSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="10,5"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource B.Line}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource B.MenuText}"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource R.Button}"
                            Padding="{TemplateBinding Padding}" Margin="4,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center"
                                              Margin="0,0,9,0"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.MenuHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource B.MenuTextDim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.MenuText}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource B.MenuBg}" BorderBrush="{DynamicResource B.MenuEdge}"
                            BorderThickness="1" CornerRadius="12" Padding="0,5" MinWidth="{TemplateBinding MinWidth}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.30"
                                              Color="#101A22"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AVISOS AL PASAR EL RATÓN
         El Tooltip nativo es un rectángulo amarillo pálido con borde fino: se
         lleva mal con todo lo demás y encima el texto de análisis es largo. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource B.MenuText}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource B.MenuBg}" BorderBrush="{DynamicResource B.MenuEdge}"
                            BorderThickness="1" CornerRadius="10" Padding="11,8" MaxWidth="380">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.28"
                                              Color="#101A22"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BARRA DE DESPLAZAMIENTO
         La de siempre ocupa 17 px y tiene dos botones con flecha. Aquí va fina,
         suelta, y solo se nota cuando el ratón está encima o se está moviendo. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="5" Margin="3,1"
                            Background="{DynamicResource B.ScrollThumb}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource B.ScrollThumbHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="12"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         DESPLEGABLES
         ============================================================ -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="{DynamicResource R.Button}"
                            Background="{DynamicResource B.Field}"
                            BorderBrush="{DynamicResource B.Line}" BorderThickness="1" Padding="11,0,9,0">
                        <TextBlock x:Name="fl" Text="&#xE70D;" FontFamily="{DynamicResource F.Icon}"
                                   FontSize="11" Foreground="{DynamicResource B.Slate}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="fl" Property="Text" Value="&#xE70E;"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource R.Button}"
                            Margin="5,2" Padding="10,7">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.MenuHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter IsHitTestVisible="False" Margin="12,0,28,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                               Focusable="False">
                            <Border Background="{DynamicResource B.MenuBg}" BorderBrush="{DynamicResource B.MenuEdge}"
                                    BorderThickness="1" CornerRadius="10" Margin="0,4,10,10"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18"
                                                      Color="#101A22"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="260" Padding="0,4">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         BANDA OSCURA: MODO Y CONMUTADORES
         ============================================================ -->

    <!-- Selector de modo (el desplegable de tres modos) -->
    <Style x:Key="ModeButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource B.BannerChip}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.BannerChipEdge}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.BannerText}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource R.Field}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="12,8">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#8FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fila del desplegable: icono + nombre + explicación de una línea -->
    <Style x:Key="ModeItem" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Main}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource R.Button}"
                            Padding="9,7">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor deslizante sobre la banda oscura -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent" Padding="2">
                        <Grid Width="56" Height="28">
                            <Border x:Name="Track" CornerRadius="14" BorderThickness="1"
                                    Background="{DynamicResource B.BannerChip}" BorderBrush="{DynamicResource B.BannerChipEdge}"/>
                            <TextBlock x:Name="GlyphOn" Text="I" FontSize="10" FontWeight="Bold"
                                       Foreground="#CCFFFFFF" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="11,0,0,0" Opacity="0"/>
                            <TextBlock x:Name="GlyphOff" Text="O" FontSize="10" FontWeight="Bold"
                                       Foreground="#80FFFFFF" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,11,0" Opacity="1"/>
                            <Border x:Name="Thumb" Width="22" Height="22" CornerRadius="11"
                                    HorizontalAlignment="Left" Margin="3,0,0,0" Background="{DynamicResource B.BannerText}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbMove" X="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.45" Color="#05141A"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbMove"
                                                         Storyboard.TargetProperty="X" To="28" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlyphOn"
                                                         Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="GlyphOff"
                                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbMove"
                                                         Storyboard.TargetProperty="X" To="0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlyphOn"
                                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="GlyphOff"
                                                         Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource B.GreenFill}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource B.ChipOkFg}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="#8FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.6"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor deslizante claro: el mismo gesto sobre fondo de tarjeta.
         Apagado se pinta con algo más de planta que antes: la pista lleva el
         reborde en el gris más subido de la paleta y la perla su propio filo,
         porque sobre tarjeta blanca las dos piezas casi del mismo tono dejaban
         el mando sin ver dónde acababa. La marca de "apagado" usa el texto
         atenuado, no el desvaído, para que se lea sin forzar la vista. -->
    <Style x:Key="SwitchClaro" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent" Padding="2">
                        <Grid Width="52" Height="26">
                            <Border x:Name="Track" CornerRadius="13" BorderThickness="1"
                                    Background="{DynamicResource B.BarTrack}" BorderBrush="{DynamicResource B.TextFaint}"/>
                            <TextBlock x:Name="GlyphOn" Text="I" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource B.OnAccent}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0"/>
                            <TextBlock x:Name="GlyphOff" Text="O" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource B.TextDim}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Opacity="1"/>
                            <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10"
                                    BorderThickness="1" BorderBrush="{DynamicResource B.Edge}"
                                    HorizontalAlignment="Left" Margin="3,0,0,0" Background="{DynamicResource B.Panel}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbMove" X="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.30"
                                                      Color="#101A22"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbMove"
                                                         Storyboard.TargetProperty="X" To="26" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlyphOn"
                                                         Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="GlyphOff"
                                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbMove"
                                                         Storyboard.TargetProperty="X" To="0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlyphOn"
                                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="GlyphOff"
                                                         Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource B.TealFill}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Thumb" Property="Opacity" Value="0.7"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Punto vivo: el halo que respira sobre el indicador de «en directo» -->
    <Style x:Key="LiveDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="{DynamicResource B.Green}"/>
    </Style>

</ResourceDictionary>
