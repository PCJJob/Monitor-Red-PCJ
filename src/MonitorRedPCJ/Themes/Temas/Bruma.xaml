<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         PALETA «BRUMA» — clara, de papel frío y acento índigo.
         ============================================================
         Es la otra cara de Nocturna: misma estructura de capas, pero en vez
         de azul verdoso usa un índigo seco y radios más cerrados. Sirve para
         quien tenga la pantalla encendida todo el día y no quiera el gris
         azulado de Aurora. -->

    <!-- ======= Fondos en capas ======= -->
    <Color x:Key="C.Bg">#F6F7FB</Color>
    <Color x:Key="C.BgDeep">#EBEEF5</Color>
    <Color x:Key="C.Panel">#FFFFFF</Color>
    <Color x:Key="C.PanelAlt">#F3F5FA</Color>
    <Color x:Key="C.Raised">#F8F9FD</Color>
    <Color x:Key="C.Header">#1E2438</Color>

    <!-- ======= Texto ======= -->
    <Color x:Key="C.Text">#171C28</Color>
    <Color x:Key="C.TextDim">#5E6779</Color>
    <Color x:Key="C.TextFaint">#98A1B2</Color>
    <Color x:Key="C.HeaderText">#C3CBE2</Color>

    <!-- ======= Acentos y estados ======= -->
    <Color x:Key="C.Accent">#3A5BE0</Color>
    <Color x:Key="C.Teal">#3A5BE0</Color>
    <Color x:Key="C.Indigo">#5B4FE0</Color>
    <Color x:Key="C.Amber">#F5A524</Color>
    <Color x:Key="C.Coral">#E5484D</Color>
    <Color x:Key="C.Green">#12A150</Color>
    <Color x:Key="C.Slate">#64748B</Color>
    <Color x:Key="C.OnAccent">#FFFFFF</Color>

    <!-- ======= Líneas y estados del ratón ======= -->
    <Color x:Key="C.Line">#E3E7EF</Color>
    <Color x:Key="C.Edge">#CFD6E3</Color>
    <Color x:Key="C.Divider">#EDF0F6</Color>
    <Color x:Key="C.Hover">#F2F5FA</Color>
    <Color x:Key="C.HoverRow">#F5F7FC</Color>
    <Color x:Key="C.Pressed">#E7ECF5</Color>
    <Color x:Key="C.Selected">#E8ECFD</Color>
    <Color x:Key="C.SelectedEdge">#AEBBEF</Color>

    <!-- ======= Campos ======= -->
    <Color x:Key="C.Field">#FFFFFF</Color>
    <Color x:Key="C.FieldEdge">#CFD6E3</Color>
    <Color x:Key="C.FieldFocus">#3A5BE0</Color>

    <!-- ======= Barra de PESO ======= -->
    <Color x:Key="C.BarTrack">#E6EAF2</Color>
    <Color x:Key="C.BarIdle">#C3CBDA</Color>

    <!-- ======= Chips ======= -->
    <Color x:Key="C.ChipOkBg">#E1F5EA</Color>
    <Color x:Key="C.ChipOkFg">#0E7A46</Color>
    <Color x:Key="C.ChipBadBg">#FDE5E6</Color>
    <Color x:Key="C.ChipBadFg">#B32A2F</Color>
    <Color x:Key="C.ChipBadPress">#F9D2D4</Color>
    <Color x:Key="C.ChipWarnBg">#FDF0DA</Color>
    <Color x:Key="C.ChipWarnFg">#9A6100</Color>
    <Color x:Key="C.ChipInfoBg">#E7EBFD</Color>
    <Color x:Key="C.ChipInfoFg">#33418F</Color>
    <Color x:Key="C.ChipNeutralBg">#EEF1F6</Color>
    <Color x:Key="C.ChipNeutralFg">#5E6779</Color>

    <!-- ======= Banda de mandos ======= -->
    <Color x:Key="C.Banner1">#1B2340</Color>
    <Color x:Key="C.Banner2">#26305A</Color>
    <Color x:Key="C.Banner3">#2E2A5E</Color>
    <Color x:Key="C.BannerEdge">#33407A</Color>
    <Color x:Key="C.BannerText">#FFFFFF</Color>
    <Color x:Key="C.BannerTextDim">#BFC9E4</Color>
    <Color x:Key="C.BannerTextFaint">#98A5C8</Color>
    <Color x:Key="C.BannerChip">#26FFFFFF</Color>
    <Color x:Key="C.BannerChipEdge">#40FFFFFF</Color>
    <Color x:Key="C.BannerDivider">#3A4670</Color>

    <!-- ======= Menús ======= -->
    <Color x:Key="C.MenuBg">#FFFFFF</Color>
    <Color x:Key="C.MenuEdge">#DCE2EE</Color>
    <Color x:Key="C.MenuHover">#EEF1FB</Color>
    <Color x:Key="C.MenuText">#171C28</Color>
    <Color x:Key="C.MenuTextDim">#727C90</Color>

    <!-- ======= Desplazamiento ======= -->
    <Color x:Key="C.ScrollBg">#00FFFFFF</Color>
    <Color x:Key="C.ScrollThumb">#C6CEDD</Color>
    <Color x:Key="C.ScrollThumbHover">#A9B4C8</Color>

    <!-- ======= Sombra ======= -->
    <Color x:Key="C.Shadow">#2E3A55</Color>

    <!-- ================= Pinceles ================= -->
    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="B.BgDeep" Color="{StaticResource C.BgDeep}"/>
    <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Panel}"/>
    <SolidColorBrush x:Key="B.PanelAlt" Color="{StaticResource C.PanelAlt}"/>
    <SolidColorBrush x:Key="B.Raised" Color="{StaticResource C.Raised}"/>
    <SolidColorBrush x:Key="B.Header" Color="{StaticResource C.Header}"/>

    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}"/>
    <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}"/>
    <SolidColorBrush x:Key="B.HeaderText" Color="{StaticResource C.HeaderText}"/>

    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="B.Teal" Color="{StaticResource C.Teal}"/>
    <SolidColorBrush x:Key="B.Indigo" Color="{StaticResource C.Indigo}"/>
    <SolidColorBrush x:Key="B.Amber" Color="{StaticResource C.Amber}"/>
    <SolidColorBrush x:Key="B.Coral" Color="{StaticResource C.Coral}"/>
    <SolidColorBrush x:Key="B.Green" Color="{StaticResource C.Green}"/>
    <SolidColorBrush x:Key="B.Slate" Color="{StaticResource C.Slate}"/>
    <SolidColorBrush x:Key="B.OnAccent" Color="{StaticResource C.OnAccent}"/>

    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="B.Edge" Color="{StaticResource C.Edge}"/>
    <SolidColorBrush x:Key="B.Divider" Color="{StaticResource C.Divider}"/>
    <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}"/>
    <SolidColorBrush x:Key="B.HoverRow" Color="{StaticResource C.HoverRow}"/>
    <SolidColorBrush x:Key="B.Pressed" Color="{StaticResource C.Pressed}"/>
    <SolidColorBrush x:Key="B.Selected" Color="{StaticResource C.Selected}"/>
    <SolidColorBrush x:Key="B.SelectedEdge" Color="{StaticResource C.SelectedEdge}"/>

    <SolidColorBrush x:Key="B.Field" Color="{StaticResource C.Field}"/>
    <SolidColorBrush x:Key="B.FieldEdge" Color="{StaticResource C.FieldEdge}"/>
    <SolidColorBrush x:Key="B.FieldFocus" Color="{StaticResource C.FieldFocus}"/>

    <SolidColorBrush x:Key="B.BarTrack" Color="{StaticResource C.BarTrack}"/>
    <SolidColorBrush x:Key="B.BarIdle" Color="{StaticResource C.BarIdle}"/>

    <SolidColorBrush x:Key="B.ChipOkBg" Color="{StaticResource C.ChipOkBg}"/>
    <SolidColorBrush x:Key="B.ChipOkFg" Color="{StaticResource C.ChipOkFg}"/>
    <SolidColorBrush x:Key="B.ChipBadBg" Color="{StaticResource C.ChipBadBg}"/>
    <SolidColorBrush x:Key="B.ChipBadFg" Color="{StaticResource C.ChipBadFg}"/>
    <SolidColorBrush x:Key="B.ChipBadPress" Color="{StaticResource C.ChipBadPress}"/>
    <SolidColorBrush x:Key="B.ChipWarnBg" Color="{StaticResource C.ChipWarnBg}"/>
    <SolidColorBrush x:Key="B.ChipWarnFg" Color="{StaticResource C.ChipWarnFg}"/>
    <SolidColorBrush x:Key="B.ChipInfoBg" Color="{StaticResource C.ChipInfoBg}"/>
    <SolidColorBrush x:Key="B.ChipInfoFg" Color="{StaticResource C.ChipInfoFg}"/>
    <SolidColorBrush x:Key="B.ChipNeutralBg" Color="{StaticResource C.ChipNeutralBg}"/>
    <SolidColorBrush x:Key="B.ChipNeutralFg" Color="{StaticResource C.ChipNeutralFg}"/>

    <SolidColorBrush x:Key="B.BannerEdge" Color="{StaticResource C.BannerEdge}"/>
    <SolidColorBrush x:Key="B.BannerText" Color="{StaticResource C.BannerText}"/>
    <SolidColorBrush x:Key="B.BannerTextDim" Color="{StaticResource C.BannerTextDim}"/>
    <SolidColorBrush x:Key="B.BannerTextFaint" Color="{StaticResource C.BannerTextFaint}"/>
    <SolidColorBrush x:Key="B.BannerChip" Color="{StaticResource C.BannerChip}"/>
    <SolidColorBrush x:Key="B.BannerChipEdge" Color="{StaticResource C.BannerChipEdge}"/>
    <SolidColorBrush x:Key="B.BannerDivider" Color="{StaticResource C.BannerDivider}"/>

    <SolidColorBrush x:Key="B.MenuBg" Color="{StaticResource C.MenuBg}"/>
    <SolidColorBrush x:Key="B.MenuEdge" Color="{StaticResource C.MenuEdge}"/>
    <SolidColorBrush x:Key="B.MenuHover" Color="{StaticResource C.MenuHover}"/>
    <SolidColorBrush x:Key="B.MenuText" Color="{StaticResource C.MenuText}"/>
    <SolidColorBrush x:Key="B.MenuTextDim" Color="{StaticResource C.MenuTextDim}"/>

    <SolidColorBrush x:Key="B.ScrollThumb" Color="{StaticResource C.ScrollThumb}"/>
    <SolidColorBrush x:Key="B.ScrollThumbHover" Color="{StaticResource C.ScrollThumbHover}"/>

    <LinearGradientBrush x:Key="B.Banner" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Banner1}" Offset="0"/>
        <GradientStop Color="{StaticResource C.Banner2}" Offset="0.55"/>
        <GradientStop Color="{StaticResource C.Banner3}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource C.Panel}" Offset="0"/>
        <GradientStop Color="{StaticResource C.Bg}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.TealFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4C6BEA" Offset="0"/>
        <GradientStop Color="#2C48C4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.CoralFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EF6065" Offset="0"/>
        <GradientStop Color="#CE3439" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.GreenFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#22B862" Offset="0"/>
        <GradientStop Color="#0B8442" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.SlateFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#728199" Offset="0"/>
        <GradientStop Color="#4E5B70" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.AuroraLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource C.Accent}" Offset="0"/>
        <GradientStop Color="{StaticResource C.Indigo}" Offset="1"/>
    </LinearGradientBrush>

    <!-- ======= Tipografía ======= -->
    <FontFamily x:Key="F.Main">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="Sz.Name">13</sys:Double>
    <sys:Double x:Key="Sz.Folder">11</sys:Double>
    <sys:Double x:Key="Sz.Num">12.5</sys:Double>
    <sys:Double x:Key="Sz.Col">10.5</sys:Double>

    <!-- ======= Geometría: radios cerrados ======= -->
    <CornerRadius x:Key="R.Card">12</CornerRadius>
    <CornerRadius x:Key="R.Panel">10</CornerRadius>
    <CornerRadius x:Key="R.Row">8</CornerRadius>
    <CornerRadius x:Key="R.Button">8</CornerRadius>
    <CornerRadius x:Key="R.Chip">5</CornerRadius>
    <CornerRadius x:Key="R.Pill">13</CornerRadius>
    <CornerRadius x:Key="R.Field">9</CornerRadius>
    <CornerRadius x:Key="R.Tile">7</CornerRadius>

    <!-- ======= Las once fichas del rediseño (mismo juego que Aurora y Nocturna) ======= -->
    <!-- En Bruma el acento es índigo, no turquesa: es el tema discreto. -->
    <Color x:Key="C.OnHeader">#FFFFFF</Color>
    <SolidColorBrush x:Key="B.OnHeader" Color="{StaticResource C.OnHeader}"/>

    <Color x:Key="C.BannerAccent">#A9BCFF</Color>
    <SolidColorBrush x:Key="B.BannerAccent" Color="{StaticResource C.BannerAccent}"/>

    <Color x:Key="C.IncogBg">#2B3566</Color>
    <Color x:Key="C.IncogEdge">#4A55A0</Color>
    <Color x:Key="C.IncogFg">#DDE3FF</Color>
    <SolidColorBrush x:Key="B.IncogBg" Color="{StaticResource C.IncogBg}"/>
    <SolidColorBrush x:Key="B.IncogEdge" Color="{StaticResource C.IncogEdge}"/>
    <SolidColorBrush x:Key="B.IncogFg" Color="{StaticResource C.IncogFg}"/>

    <LinearGradientBrush x:Key="B.AuroraFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Teal}" Offset="0"/>
        <GradientStop Color="{StaticResource C.Indigo}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
